{
  "name": "zefox-presence-bridge",
  "version": "0.9.13",
  "description": "Local Discord Rich Presence bridge app for ZeFoX.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:icons": "node build/create-app-icon.js",
    "build:win": "npm run build:icons && electron-builder --win"
  },
  "keywords": [
    "zefox",
    "discord",
    "rich-presence",
    "electron"
  ],
  "author": "VZefoq",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "app.zefoxx.presencebridge",
    "productName": "ZeFoX Presence Bridge",
    "files": [
      "main.js",
      "bridge.js",
      "preload.js",
      "renderer.html",
      "renderer.css",
      "renderer.js",
      "assets/**/*",
      "package.json"
    ],
    "artifactName": "ZeFoX-Presence-Bridge-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "VZefoq",
        "repo": "ZeFoX-RPC"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build/after-pack.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "include": "build/installer.nsh"
    }
  }
}
